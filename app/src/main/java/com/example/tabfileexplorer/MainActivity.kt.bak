// --- Helper Composables for UI States (Permission, Loading, Empty) ---
object NavRoutes {
    const val HOME = "home"
    const val FILE_EXPLORER = "file_explorer"
    const val PATH_ARG = "path"
}

enum class ViewMode {
    LIST, GRID
}

enum class SortMethod {
    NAME, DATE, SIZE, TYPE
}

enum class SortOrder {
    ASCENDING, DESCENDING
}

data class StorageStats(
    val totalSpace: Long,
    val freeSpace: Long
) {
    val usedSpace: Long
        get() = totalSpace - freeSpace
}

// Data classes
data class StorageOption(
    val name: String,
    val path: String,
    val icon: ImageVector,
    val iconTint: Color
)

private fun Context.getStorageStats(): StorageStats {
    val stat = StatFs(Environment.getDataDirectory().path)
    val blockSize = stat.blockSizeLong
    val totalBlocks = stat.blockCountLong
    val availableBlocks = stat.availableBlocksLong

    return StorageStats(
        totalSpace = totalBlocks * blockSize,
        freeSpace = availableBlocks * blockSize
    )
}

// FileUtils, FileModel, and extension functions are now expected from FileUtils.kt
class MainActivity : ComponentActivity() {
}
    private lateinit var appSettings: AppSettings
    private val manageStoragePermissionLauncher =
        registerForActivityResult(ActivityResultContracts.StartActivityForResult()) {
            Log.d("Permissions", "Returned from settings. Checking permission status.")
            updatePermissionStates(true)
        }

    // --- All App State ---
    private var fileListState by mutableStateOf<List<FileModel>>(emptyList())
    private var currentPathState by mutableStateOf("")
    private var permissionDeniedState by mutableStateOf(false)
    private var hasSystemManagerPermissionState by mutableStateOf(false)
    private var isLoading by mutableStateOf(false)
    private var showCreateFolderDialog by mutableStateOf(false)
    private var newFolderName by mutableStateOf("")
    private var selectedFileForAction by mutableStateOf<FileModel?>(null)
    private var showOptionsMenuForFile by mutableStateOf<FileModel?>(null) // ADDED: State for options menu
    private var showConfirmDeleteDialog by mutableStateOf(false)
    private var searchQuery by mutableStateOf("")
    private var isSearchActive by mutableStateOf(false)
    private var viewMode by mutableStateOf(ViewMode.LIST)
    private var selectedFiles by mutableStateOf<Set<FileModel>>(emptySet())
    private var showSelectionMoreMenu by mutableStateOf(false)
    private var showConfirmMultiDeleteDialog by mutableStateOf(false)
    private var showPropertiesDialog by mutableStateOf(false)
    private var fileForPropertiesDialog by mutableStateOf<FileModel?>(null)
    private var sortMethod by mutableStateOf(SortMethod.NAME)
    private var sortOrder by mutableStateOf(SortOrder.ASCENDING)
    private var showSortMenu by mutableStateOf(false)
    private var isSplitScreenActive by mutableStateOf(false)
    private var rightPanelPath by mutableStateOf("")
    private var rightPanelFileList by mutableStateOf<List<FileModel>>(emptyList())
    private var clipboardData: Pair<String, Boolean>? = null // path to file and isCut flag
    private var showRenameDialog by mutableStateOf(false)
    private var newFileName by mutableStateOf("")
    private var isAtRoot by mutableStateOf(true)

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        enableEdgeToEdge()
        appSettings = AppSettings(this)
        updatePermissionStates()

        setContent {
            // Collect theme preference
            val isDarkTheme by appSettings.themePreference.collectAsState(initial = false)
            
            TabFileExplorerTheme(darkTheme = isDarkTheme) {
                // Create nav controller
                val navController = rememberNavController()
                
                // Setup navigation
                NavGraph(
                    navController = navController,
                    appSettings = appSettings
                )
            }
            // Collect theme preference
            val isDarkTheme by appSettings.themePreference.collectAsState(initial = false)
            
            TabFileExplorerTheme(darkTheme = isDarkTheme) {
                // Create nav controller
                val navController = rememberNavController()
                
                // Setup navigation
                NavGraph(
                    navController = navController,
                    appSettings = appSettings
                )
            }
            // Collect theme preference
            val isDarkTheme by appSettings.themePreference.collectAsState(initial = false)
            
            TabFileExplorerTheme(darkTheme = isDarkTheme) {
                // Create nav controller
                val navController = rememberNavController()
                
                // Setup navigation
                NavGraph(
                    navController = navController,
                    appSettings = appSettings
                )
            }
            TabFileExplorerTheme {
                val navController = rememberNavController()
                val filteredAndSortedList =
                    remember(searchQuery, fileListState, sortMethod, sortOrder) {
                        val filtered = if (searchQuery.isBlank()) {
                            fileListState
                        } else {
                            fileListState.filter {
                                it.name.contains(searchQuery, ignoreCase = true)
                            }
                        }
                        // Now, sort the filtered list
                        val sorted = when (sortMethod) {
                            SortMethod.NAME -> filtered.sortedBy { it.name.lowercase(Locale.getDefault()) }
                            SortMethod.DATE -> filtered.sortedBy { it.lastModified }
                            SortMethod.SIZE -> filtered.sortedBy { it.size }
                            SortMethod.TYPE -> filtered.sortedBy {
                                it.name.substringAfterLast(
                                    '.',
                                    ""
                                ).lowercase(Locale.getDefault())
                            }
                        }

                        // Finally, apply the ascending/descending order
                        val result =
                            if (sortOrder == SortOrder.DESCENDING) {
                                sorted.reversed()
                            } else {
                                sorted
                            }
                        // This is the crucial last step: always put directories first.
                        result.sortedBy { !it.isDirectory }
                    }

                // Set up the NavHost to manage screens
                NavHost(
                    navController = navController,
                    startDestination = NavRoutes.HOME
                ) {
                    // Route for the "home" screen
                    composable(NavRoutes.HOME) {
                        HomeScreen(onNavigateToStorage = { storagePath ->
                            val encodedPath =
                                URLEncoder.encode(storagePath, StandardCharsets.UTF_8.toString())
                            navController.navigate("${NavRoutes.FILE_EXPLORER}/$encodedPath")
                        })
                    }

                    // Route for the "file_explorer" screen
                    composable(
                        route = "${NavRoutes.FILE_EXPLORER}/{${NavRoutes.PATH_ARG}}",
                        arguments = listOf(navArgument(NavRoutes.PATH_ARG) {
                            type = NavType.StringType
                        })
                    ) { backStackEntry ->
                        val path = URLDecoder.decode(
                            backStackEntry.arguments?.getString(NavRoutes.PATH_ARG) ?: "",
                            StandardCharsets.UTF_8.toString()
                        )

                        // Pass all the necessary data and functions to the File Explorer screen.
                        MainAppContent(
                            initialPath = path,
                            fileList = filteredAndSortedList,
                            currentPath = currentPathState,
                            isLoading = isLoading,
                            permissionDenied = permissionDeniedState,
                            hasSystemManagerPermission = hasSystemManagerPermissionState,
                            viewMode = viewMode,
                            onViewModeChange = { newMode -> viewMode = newMode },
                            selectedFiles = selectedFiles,
                            onSelectionChange = { file ->
                                selectedFiles =
                                    if (selectedFiles.contains(file)) selectedFiles - file
                                    else selectedFiles + file
                            },
                            onClearSelection = { selectedFiles = emptySet() },
                            showSelectionMoreMenu = showSelectionMoreMenu,
                            onShowSelectionMoreMenu = { showSelectionMoreMenu = true },
                            onDismissSelectionMoreMenu = { showSelectionMoreMenu = false },
                            showOptionsMenuForFile = showOptionsMenuForFile,
                            isSearchActive = isSearchActive,
                            searchQuery = searchQuery,
                            onSearchQueryChange = { newQuery -> searchQuery = newQuery },
                            onSearchActiveChange = { isActive -> isSearchActive = isActive },
                            onLoadFiles = { newPath ->
                                searchQuery = ""
                                isSearchActive = false
                                selectedFiles = emptySet()
                                loadFiles(newPath)
                            },
                            onNavigateUp = {
                                searchQuery = ""
                                isSearchActive = false
                                selectedFiles = emptySet()
                                navigateUp()
                            },
                            onNavigateHome = {
                                navController.popBackStack(
                                    NavRoutes.HOME,
                                    inclusive = false
                                )
                            },
                            onOpenFile = { file -> openFile(file) },
                            onShowOptionsMenu = { file -> showOptionsMenuForFile = file },
                            onDismissOptionsMenu = { showOptionsMenuForFile = null },
                            onShowCreateFolderDialog = {
                                newFolderName = ""
                                showCreateFolderDialog = true
                            },
                            onDeleteFileAction = { file ->
                                selectedFileForAction = file
                                showConfirmDeleteDialog = true
                                showOptionsMenuForFile = null
                            },
                            onRenameFileClickAction = {
                                Toast.makeText(
                                    this@MainActivity,
                                    "Rename coming soon!",
                                    Toast.LENGTH_SHORT
                                ).show()
                            },
                            onDeleteSelectedFiles = { showConfirmMultiDeleteDialog = true },
                            onShareFiles = { file ->
                                // If a specific file is provided, share it. Otherwise, share the multi-selection.
                                if (file != null) {
                                    shareFiles(setOf(file))
                                } else {
                                    shareFiles(selectedFiles)
                                }
                            },
                            onShowProperties = { file ->
                                // This now handles both cases
                                fileForPropertiesDialog = file
                                showPropertiesDialog = true
                            },
                            onOpenSettings = { openAppSettingsToGrantPermission() },
                            sortMethod = sortMethod,
                            sortOrder = sortOrder,
                            onSortMethodChange = { sortMethod = it },
                            onSortOrderChange = { sortOrder = it },
                            showSortMenu = showSortMenu,
                            onShowSortMenuChange = { showSortMenu = it },
                            onToggleSplitScreen = { isSplitScreenActive = !isSplitScreenActive },
                            isSplitScreenActive = isSplitScreenActive
                        )
                    }
                }

                if (showCreateFolderDialog) {
                    CreateFolderDialog(
                        folderName = newFolderName,
                        onFolderNameChange = { newFolderName = it },
                        onDismissRequest = { showCreateFolderDialog = false; newFolderName = "" },
                        onCreateClick = {
                            showCreateFolderDialog = false
                            createNewFolderInCurrentPath(newFolderName.trim())
                        },
                        onCancelClick = { showCreateFolderDialog = false; newFolderName = "" }
                    )
                }

                if (showConfirmDeleteDialog && selectedFileForAction != null) {
                    ConfirmDeleteDialog(
                        file = selectedFileForAction!!,
                        onConfirm = {
                            deleteFileOrFolder(selectedFileForAction!!)
                            showConfirmDeleteDialog = false
                            selectedFileForAction = null
                        },
                        onDismiss = {
                            showConfirmDeleteDialog = false
                            selectedFileForAction = null
                        }
                    )
                }
                if (showConfirmMultiDeleteDialog) {
                    AlertDialog(
                        onDismissRequest = { showConfirmMultiDeleteDialog = false },
                        title = { Text("Confirm Delete") },
                        text = { Text("Are you sure you want to delete ${selectedFiles.size} item(s)? This cannot be undone.") },
                        confirmButton = {
                            Button(
                                onClick = {
                                    deleteSelectedFiles()
                                    showConfirmMultiDeleteDialog = false
                                },
                                colors = ButtonDefaults.buttonColors(containerColor = MaterialTheme.colorScheme.error)
                            ) {
                                Text("Delete")
                            }
                        },
                        dismissButton = {
                            TextButton(onClick = { showConfirmMultiDeleteDialog = false }) {
                                Text("Cancel")
                            }
                        }
                    )
                }
                if (showPropertiesDialog) {
                    // If we have a specific file to show from the single-item menu...
                    if (fileForPropertiesDialog != null) {
                        PropertiesDialog(
                            // Pass an empty set for selectedFiles to ensure it uses the single-item logic
                            selectedFiles = emptySet(),
                            fileToShow = fileForPropertiesDialog,
                            onDismissRequest = {
                                showPropertiesDialog = false
                                fileForPropertiesDialog = null // Clean up the state
                            }
                        )
                    }
                    // Otherwise, if there are multiple files selected...
                    else if (selectedFiles.isNotEmpty()) {
                        PropertiesDialog(
                            selectedFiles = selectedFiles,
                            fileToShow = null, // Ensure it uses the multi-select logic
                            onDismissRequest = { showPropertiesDialog = false }
                        )
                    }
                }
            }
        }
    }

    override fun onResume() {
        super.onResume()
        updatePermissionStates(true)
    }

    private fun updatePermissionStates(forceReload: Boolean = false) {
        val oldPermissionDeniedState = permissionDeniedState
        val hasPermission = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.R) {
            Environment.isExternalStorageManager().also { hasSystemManagerPermissionState = it }
        } else {
            ContextCompat.checkSelfPermission(
                this,
                Manifest.permission.READ_EXTERNAL_STORAGE
            ) == PackageManager.PERMISSION_GRANTED
        }

        permissionDeniedState = !hasPermission
        Log.d("Permissions", "Permission check complete. Denied: $permissionDeniedState")
        if ((oldPermissionDeniedState && hasPermission) || (forceReload && hasPermission)) {
            val pathToLoad = currentPathState.ifBlank { FileUtils.getRootDirectory().absolutePath }
            Log.d(
                "Permissions",
                "Permission newly granted or resumed, reloading for path: $pathToLoad"
            )
            loadFiles(pathToLoad)
        }
    }

    private fun openAppSettingsToGrantPermission() {
        val intent = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.R) {
            Intent(Settings.ACTION_MANAGE_APP_ALL_FILES_ACCESS_PERMISSION).apply {
                data = "package:$packageName".toUri()
            }
        } else {
            Intent(Settings.ACTION_APPLICATION_DETAILS_SETTINGS).apply {
                data = "package:$packageName".toUri()
            }
        }
        manageStoragePermissionLauncher.launch(intent)
    }

    private fun loadFiles(path: String) {
        // Update isAtRoot state based on the new path
        isAtRoot = path == Environment.getExternalStorageDirectory().absolutePath
        
        if (path.isBlank() || permissionDeniedState) {
            Log.w("LoadFiles", "Aborted load for path '$path'. Blank path or permission denied.")
            return
        }
        isLoading = true
        lifecycleScope.launch {
            fileListState = try {
                val files = withContext(Dispatchers.IO) { FileUtils.getFiles(path) }
                currentPathState = path
                files
            } catch (e: Exception) {
                Log.e("LoadFiles", "Error loading files for path $path", e)
                emptyList()
            }
            isLoading = false
        }
    }


    
    private fun navigateUp() {
        val currentFile = File(currentPathState)
        val parent = currentFile.parentFile ?: return
        
        // Check if we're navigating up to the root
        if (parent.absolutePath == Environment.getExternalStorageDirectory().absolutePath) {
            isAtRoot = true
        }
        
        if (parent.canRead()) {
            loadFiles(parent.absolutePath)
        }
    }

    private fun createNewFolderInCurrentPath(folderName: String) {
        if (folderName.isBlank()) {
            Toast.makeText(this, "Folder name cannot be empty", Toast.LENGTH_SHORT).show()
            return
        }
        lifecycleScope.launch {
            withContext(Dispatchers.IO) { File(currentPathState, folderName).mkdir() }
            loadFiles(currentPathState)
        }
    }

    private fun deleteFileOrFolder(fileModel: FileModel) {
        lifecycleScope.launch {
            val success = withContext(Dispatchers.IO) { File(fileModel.path).deleteRecursively() }
            if (success) {
                Toast.makeText(this@MainActivity, "Deleted '${fileModel.name}'", Toast.LENGTH_SHORT)
                    .show()
                loadFiles(currentPathState)
            } else {
                Toast.makeText(this@MainActivity, "Failed to delete", Toast.LENGTH_SHORT).show()
            }
        }
    }

    private fun deleteSelectedFiles() {
        val filesToDelete = selectedFiles.toList() // Create a stable copy
        if (filesToDelete.isEmpty()) return

        lifecycleScope.launch {
            var successCount = 0
            withContext(Dispatchers.IO) {
                filesToDelete.forEach { fileModel ->
                    if (File(fileModel.path).deleteRecursively()) {
                        successCount++
                    }
                }
            }

            Toast.makeText(this@MainActivity, "$successCount  item(s) deleted", Toast.LENGTH_SHORT)
                .show()
            selectedFiles = emptySet() // Clear the selection
            loadFiles(currentPathState) // Refresh the file list
        }
    }

    private fun openFile(fileModel: FileModel) {
        val file = File(fileModel.path)
        if (!file.exists()) {
            Toast.makeText(this, "File does not exist.", Toast.LENGTH_SHORT).show()
            return
        }
        try {
            val uri = FileProvider.getUriForFile(this, "${this.packageName}.provider", file)
            val mimeType = MimeTypeMap.getSingleton().getMimeTypeFromExtension(file.extension)
            val intent = Intent(Intent.ACTION_VIEW).apply {
                setDataAndType(uri, mimeType)
                addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
            }
            startActivity(intent)
        } catch (e: Exception) {
            Log.e("OpenFile", "No app can open this file.", e)
            Toast.makeText(this, "No application found to open this file.", Toast.LENGTH_SHORT)
                .show()
        }
    }

    private fun shareFiles(filesToShare: Set<FileModel>) {
        if (filesToShare.isEmpty()) {
            Toast.makeText(this, "No files selected to share.", Toast.LENGTH_SHORT).show()
            return
        }

        val uris = filesToShare.mapNotNull { fileModel ->
            try {
                val file = File(fileModel.path)
                if (file.exists()) {
                    FileProvider.getUriForFile(this, "${this.packageName}.provider", file)
                } else {
                    null
                }
            } catch (e: Exception) {
                Log.e("Share", "Error getting URI for file: ${fileModel.path}", e)
                null
            }
        }.toCollection(ArrayList()) // Convert to ArrayList, which is required by the Intent

        if (uris.isEmpty()) {
            Toast.makeText(this, "Could not share the selected files.", Toast.LENGTH_SHORT).show()
            return
        }

        val intent = Intent().apply {
            // Use ACTION_SEND_MULTIPLE for sharing more than one file
            action = if (uris.size > 1) Intent.ACTION_SEND_MULTIPLE else Intent.ACTION_SEND
            addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)

            if (uris.size > 1) {
                putParcelableArrayListExtra(Intent.EXTRA_STREAM, uris)
                // Determine a general MIME type
                type = "*/*"
            } else {
                val singleUri = uris.first()
                putExtra(Intent.EXTRA_STREAM, singleUri)
                // Get a specific MIME type for a single file
                type = contentResolver.getType(singleUri) ?: "*/*"
            }
        }

        // Create a chooser to let the user pick an app
        val chooser = Intent.createChooser(intent, "Share with...")
        try {
            startActivity(chooser)
        } catch (e: Exception) {
            Toast.makeText(this, "No application found to handle sharing.", Toast.LENGTH_SHORT)
                .show()
        }
    }

    private fun showRenameDialog(fileModel: FileModel) {
        selectedFileForAction = fileModel
        // Set the initial name without extension if it has one
        newFileName = if (fileModel.name.contains('.')) {
            fileModel.name.substringBeforeLast('.')
        } else {
            fileModel.name
        }
        showRenameDialog = true
    }

    private fun copyPathToClipboard(path: String) {
        val clipboard = getSystemService(Context.CLIPBOARD_SERVICE) as ClipboardManager
        val clip = ClipData.newPlainText("File Path", path)
        clipboard.setPrimaryClip(clip)
        Toast.makeText(this, "Path copied to clipboard", Toast.LENGTH_SHORT).show()
    }

    private fun renameFile() {
        val oldFile = selectedFileForAction ?: return
        val oldFileObj = File(oldFile.path)

        // Determine the new name with extension
        val hasExtension = oldFile.name.contains('.')
        val extension = if (hasExtension) ".${oldFile.name.substringAfterLast('.')}" else ""
        val newName = if (hasExtension && !newFileName.endsWith(extension)) {
            "$newFileName$extension"
        } else {
            newFileName
        }

        val newFile = File(oldFileObj.parent, newName)

        lifecycleScope.launch {
            try {
                val success = withContext(Dispatchers.IO) {
                    // Check if the new name already exists
                    if (newFile.exists() && newFile.absolutePath != oldFileObj.absolutePath) {
                        return@withContext false
                    }
                    oldFileObj.renameTo(newFile)
                }

                if (success) {
                    loadFiles(currentPathState)
                    showRenameDialog = false
                    selectedFileForAction = null
                    newFileName = ""
                    Toast.makeText(this@MainActivity, "Renamed successfully", Toast.LENGTH_SHORT)
                        .show()
                } else {
                    Toast.makeText(
                        this@MainActivity,
                        "Failed to rename. The file may be in use or a file with that name already exists.",
                        Toast.LENGTH_SHORT
                    ).show()
                }
            } catch (e: Exception) {
                Log.e("RenameError", "Error renaming file", e)
                Toast.makeText(this@MainActivity, "Error: ${e.message}", Toast.LENGTH_SHORT).show()
            }
        }
    }

    private fun copyToClipboard(file: FileModel) {
        clipboardData = file.path to false // false means copy operation
        Toast.makeText(this, "Copied to clipboard", Toast.LENGTH_SHORT).show()
    }

    private fun cutToClipboard(file: FileModel) {
        clipboardData = file.path to true // true means cut operation
        Toast.makeText(this, "Cut to clipboard", Toast.LENGTH_SHORT).show()
    }

    private fun pasteFromClipboard(
        destinationDir: File? = null,
        snackbarHostState: SnackbarHostState
    ) {
        val (sourcePath, isCut) = clipboardData ?: return
        val sourceFile = File(sourcePath)
        val targetDir = destinationDir ?: File(currentPathState)
        val destinationFile = File(targetDir, sourceFile.name)

        // Dismiss the snackbar when pasting
        lifecycleScope.launch {
            try {
                // Dismiss the snackbar
                snackbarHostState.currentSnackbarData?.dismiss()

                withContext(Dispatchers.IO) {
                    if (isCut) {
                        // Move operation
                        if (sourceFile.renameTo(destinationFile)) {
                            // Update UI
                            withContext(Dispatchers.Main) {
                                loadFiles(currentPathState)
                                // If we cut from a different directory, refresh that directory too
                                if (sourceFile.parent != currentPathState) {
                                    sourceFile.parent?.let { parentPath ->
                                        loadFiles(parentPath)
                                    }
                                }
                            }
                        }
                    } else {
                        // Copy operation
                        if (sourceFile.isDirectory) {
                            sourceFile.copyRecursively(destinationFile, overwrite = true)
                        } else {
                            sourceFile.copyTo(destinationFile, overwrite = true)
                        }
                        // Refresh current directory
                        withContext(Dispatchers.Main) {
                            loadFiles(currentPathState)
                        }
                    }
                }
                // Clear clipboard after successful paste if it was a cut operation
                if (isCut) {
                    clipboardData = null
                }
                // Show success message in snackbar
                snackbarHostState.showSnackbar(
                    message = "Pasted to ${targetDir.name}",
                    duration = SnackbarDuration.Short
                )
            } catch (e: Exception) {
                Log.e("PasteError", "Error pasting file", e)
                // Show error in snackbar
                snackbarHostState.showSnackbar(
                    message = "Error: ${e.message ?: "Failed to paste"}",
                    duration = SnackbarDuration.Short
                )
            }
        }
    }

    // --- Helper Composables for UI States (Permission, Loading, Empty) ---
    @Composable
    fun MainAppContent(
        initialPath: String,
        fileList: List<FileModel>,
        currentPath: String,
        isLoading: Boolean,
        permissionDenied: Boolean,
        hasSystemManagerPermission: Boolean,
        viewMode: ViewMode,
        onViewModeChange: (ViewMode) -> Unit,
        selectedFiles: Set<FileModel>,
        onSelectionChange: (FileModel) -> Unit,
        onClearSelection: () -> Unit,
        showSelectionMoreMenu: Boolean,
        onShowSelectionMoreMenu: () -> Unit,
        onDismissSelectionMoreMenu: () -> Unit,
        showOptionsMenuForFile: FileModel?,
        isSearchActive: Boolean,
        searchQuery: String,
        onSearchQueryChange: (String) -> Unit,
        onSearchActiveChange: (Boolean) -> Unit,
        onLoadFiles: (String) -> Unit,
        onNavigateUp: () -> Unit,
        onNavigateHome: () -> Unit,
        onOpenFile: (FileModel) -> Unit,
        onShowOptionsMenu: (FileModel) -> Unit,
        onDismissOptionsMenu: () -> Unit,
        onShowCreateFolderDialog: () -> Unit,
        onDeleteFileAction: (FileModel) -> Unit,
        onRenameFileClickAction: (FileModel) -> Unit,
        onDeleteSelectedFiles: () -> Unit,
        onShareFiles: (FileModel?) -> Unit,
        onShowProperties: (file: FileModel?) -> Unit,
        onOpenSettings: () -> Unit,
        sortMethod: SortMethod,
        sortOrder: SortOrder,
        onSortMethodChange: (SortMethod) -> Unit,
        onSortOrderChange: (SortOrder) -> Unit,
        showSortMenu: Boolean,
        onShowSortMenuChange: (Boolean) -> Unit,
        onToggleSplitScreen: () -> Unit,
        isSplitScreenActive: Boolean
    ) {
        val isRPlus = Build.VERSION.SDK_INT >= Build.VERSION_CODES.R
        val context = LocalContext.current
        val isAtRoot = currentPath == Environment.getExternalStorageDirectory().absolutePath

        // This effect runs when the screen appears or its path/permissions change.
        LaunchedEffect(initialPath, hasSystemManagerPermission) {
            if (!permissionDenied && (if (isRPlus) hasSystemManagerPermission else true)) {
                Log.d("MainAppContent", "LaunchedEffect: Loading files for path: $initialPath")
                onLoadFiles(initialPath)
            }
        }

        // --- UI State Logic: Decide what to show (permission, loading, content) ---
        when {
            permissionDenied -> {
                Log.d("UIState", "Displaying 'All Files Access Denied' screen.")
                PermissionDeniedScreen(onOpenSettingsClick = onOpenSettings)
            }

            isRPlus && !hasSystemManagerPermission -> {
                RequestPermissionScreen(onGrantSettingsClick = onOpenSettings)
            }

            isAtRoot -> {
                // Show HomeScreen when at root directory
                HomeScreen(
                    onNavigateToStorage = onLoadFiles,
                    onSettingsClick = onOpenSettings,
                    onAboutClick = { /* TODO: Handle about click */ }
                )
            }

            else -> {
                Row(modifier = Modifier.fillMaxSize()) {
                    // --- Left Panel (Always Visible) ---
                    Box(modifier = Modifier.weight(1f)) {
                        FileListScreen(
                            files = fileList,
                            currentPath = currentPath,
                            onFileClick = onLoadFiles,
                            onNavigateUp = onNavigateUp,
                            modifier = Modifier,
                            context = context,
                            isSearchActive = isSearchActive,
                            searchQuery = searchQuery,
                            onSearchQueryChange = onSearchQueryChange,
                            onSearchActiveChange = onSearchActiveChange,
                            viewMode = viewMode,
                            onViewModeChange = onViewModeChange,
                            selectedFiles = selectedFiles,
                            onSelectionChange = onSelectionChange,
                            onClearSelection = onClearSelection,
                            showSelectionMoreMenu = showSelectionMoreMenu,
                            onShowSelectionMoreMenu = onShowSelectionMoreMenu,
                            onDismissSelectionMoreMenu = onDismissSelectionMoreMenu,
                            showOptionsMenuForFile = showOptionsMenuForFile,
                            onShowOptionsMenu = onShowOptionsMenu,
                            onDismissOptionsMenu = onDismissOptionsMenu,
                            onOpenFileClickAction = onOpenFile,
                            onRenameFileClickAction = { file ->
                                // TODO: Implement rename functionality
                                onDismissOptionsMenu()
                            },
                            onDeleteFileClickAction = { file ->
                                onDeleteFileAction(file)
                                onDismissOptionsMenu()
                            },
                            onDeleteSelectedFiles = onDeleteSelectedFiles,
                            onShareFiles = { file ->
                                onShareFiles(file)
                            },
                            onShowProperties = { file ->
                                onShowProperties(
                                    file ?: showOptionsMenuForFile
                                )
                            },
                            sortMethod = sortMethod,
                            sortOrder = sortOrder,
                            onSortMethodChange = onSortMethodChange,
                            onSortOrderChange = onSortOrderChange,
                            showSortMenu = showSortMenu,
                            onShowSortMenuChange = onShowSortMenuChange,
                            onToggleSplitScreen = { /* TODO: Implement split screen toggle */ },
                            isSplitScreenActive = false
                        )

                        // Overlays for the left panel
                        if (isLoading) {
                            LoadingIndicatorOverlay()
                        } else if (fileList.isEmpty() && currentPath.isNotBlank()) {
                            EmptyFolderView(
                                currentPath = currentPath,
                                onCreateFolderClick = onShowCreateFolderDialog
                            )
                        }
                    }

                    // --- Right Panel (Conditionally Visible) ---
                    if (isSplitScreenActive) {
                        VerticalDivider(
                            modifier = Modifier
                                .fillMaxHeight()
                                .width(1.dp), color = MaterialTheme.colorScheme.outlineVariant
                        )

                        Box(modifier = Modifier.weight(1f)) {
                            // This is a NEW FileListScreen instance for the right side.
                            // For now, it will be a read-only clone of the left side.
                            FileListScreen(
                                files = fileList, // Shows the same files for now
                                currentPath = currentPath, // Shows the same path for now
                                context = context,
                                // Disable most actions on the right panel for simplicity
                                onFileClick = {},
                                onNavigateUp = {},
                                isSearchActive = false,
                                searchQuery = "",
                                onSearchQueryChange = {},
                                onSearchActiveChange = {},
                                viewMode = viewMode,
                                onViewModeChange = {},
                                selectedFiles = emptySet(),
                                onSelectionChange = {},
                                onClearSelection = {},
                                showSelectionMoreMenu = false,
                                onShowSelectionMoreMenu = {},
                                onDismissSelectionMoreMenu = {},
                                showOptionsMenuForFile = null,
                                onShowOptionsMenu = {},
                                onDismissOptionsMenu = {},
                                onOpenFileClickAction = onOpenFile, // Still allow opening files
                                onRenameFileClickAction = {},
                                onDeleteSelectedFiles = {},
                                onDeleteFileClickAction = {},
                                onShareFiles = {},
                                onShowProperties = {},
                                sortMethod = sortMethod,
                                sortOrder = sortOrder,
                                onSortMethodChange = {},
                                onSortOrderChange = {},
                                showSortMenu = false,
                                onShowSortMenuChange = {},
                                onToggleSplitScreen = {}, // Hide the button on the right panel
                                isSplitScreenActive = isSplitScreenActive
                            )
                        }
                    }
                    if (showRenameDialog && selectedFileForAction != null) {
                        RenameDialog(
                            currentFile = selectedFileForAction!!,
                            newFileName = newFileName,
                            onNewFileNameChange = { newFileName = it },
                            onDismiss = {
                                showRenameDialog = false
                                selectedFileForAction = null
                                newFileName = ""
                            },
                            onConfirm = {
                                // Add the extension back before renaming
                                val hasExtension =
                                    selectedFileForAction?.name?.contains('.') ?: false
                                val extension = if (hasExtension) ".${
                                    selectedFileForAction?.name?.substringAfterLast('.')
                                }" else ""

                                if (hasExtension && !newFileName.endsWith(extension)) {
                                    newFileName += extension
                                }
                                renameFile()
                            },
                            isNameValid = newFileName.isNotBlank() &&
                                    newFileName != selectedFileForAction?.name?.substringBeforeLast(
                                '.',
                                missingDelimiterValue = selectedFileForAction?.name ?: ""
                            )
                        )
                    }
                }
            }
        }
    }

    @Composable
    fun PermissionDeniedScreen(onOpenSettingsClick: () -> Unit) {
        Surface( // Wrap with Surface
            modifier = Modifier.fillMaxSize(),
            color = MaterialTheme.colorScheme.background // Explicitly use theme background
        ) {
            Box(
                // modifier = Modifier.fillMaxSize(), // Box might not need fillMaxSize if Surface has it
                contentAlignment = Alignment.Center
            ) {
                Column(
                    horizontalAlignment = Alignment.CenterHorizontally,
                    modifier = Modifier.padding(16.dp)
                ) {
                    Icon(
                        imageVector = Icons.Filled.Lock,
                        contentDescription = "Permission Denied Icon",
                        modifier = Modifier.size(48.dp),
                        tint = MaterialTheme.colorScheme.error
                    )
                    Spacer(modifier = Modifier.height(16.dp))
                    Text(
                        "All Files Access Denied",
                        style = MaterialTheme.typography.titleMedium,
                        color = MaterialTheme.colorScheme.error
                    )
                    Text(
                        "File explorer needs this permission to function. Please grant it in settings.",
                        style = MaterialTheme.typography.bodyMedium,
                        // For body text on a generic background, onSurface or onBackground is often more appropriate than onSurfaceVariant
                        color = MaterialTheme.colorScheme.onBackground, // Or onSurface
                        modifier = Modifier.padding(top = 8.dp)
                    )
                    Spacer(modifier = Modifier.height(24.dp))
                    Button(onClick = onOpenSettingsClick) {
                        Text("Open Settings")
                    }
                }
            }
        }
    }

    @Composable
    fun RequestPermissionScreen(onGrantSettingsClick: () -> Unit) {
        Surface( // Wrap with Surface
            modifier = Modifier.fillMaxSize(),
            color = MaterialTheme.colorScheme.background // Explicitly use theme background
        ) {
            Box(
                // modifier = Modifier.fillMaxSize(),
                contentAlignment = Alignment.Center
            ) {
                Column(
                    horizontalAlignment = Alignment.CenterHorizontally,
                    modifier = Modifier.padding(16.dp)
                ) {
                    Icon(
                        imageVector = Icons.Filled.FolderShared,
                        contentDescription = "Request Permission Icon",
                        modifier = Modifier.size(48.dp),
                        tint = MaterialTheme.colorScheme.primary
                    )
                    Spacer(modifier = Modifier.height(16.dp))
                    Text(
                        "Grant All Files Access",
                        style = MaterialTheme.typography.titleMedium,
                        // Text on a generic background, consider onBackground or onSurface
                        color = MaterialTheme.colorScheme.onBackground // Or onSurface
                    )
                    Text(
                        "This app needs 'All Files Access' to browse your storage effectively.",
                        style = MaterialTheme.typography.bodyMedium,
