    @Composable
    private fun StorageOverviewCard(
        usedSpace: Long,
        totalSpace: Long,
        onManageClick: () -> Unit,
        modifier: Modifier = Modifier
    ) {
        val usedGb = usedSpace / (1024 * 1024 * 1024f)
        val totalGb = totalSpace / (1024 * 1024 * 1024f)
        val progress = (usedGb / totalGb).coerceIn(0f, 1f)

        Card(
            onClick = onManageClick,
            modifier = modifier.fillMaxWidth(),
            colors = CardDefaults.cardColors(
                containerColor = MaterialTheme.colorScheme.surface
            )
        ) {
            Column(
                modifier = Modifier
                    .fillMaxWidth()
                    .padding(16.dp),
                verticalArrangement = Arrangement.spacedBy(16.dp)
            ) {
                Row(
                    modifier = Modifier.fillMaxWidth(),
                    horizontalArrangement = Arrangement.SpaceBetween
                ) {
                    Text(
                        "Storage",
                        style = MaterialTheme.typography.titleMedium
                    )
                    Text(
                        "${"%.1f".format(usedGb)} GB of ${"%.1f".format(totalGb)} GB used",
                        style = MaterialTheme.typography.bodySmall,
                        color = MaterialTheme.colorScheme.onSurfaceVariant
                    )
                }

                LinearProgressIndicator(
                    progress = { progress },
                    modifier = Modifier
                        .fillMaxWidth()
                        .height(8.dp)
                        .clip(CircleShape),
                    color = MaterialTheme.colorScheme.primary,
                    trackColor = MaterialTheme.colorScheme.surfaceVariant
                )

                Row(
                    modifier = Modifier.fillMaxWidth(),
                    horizontalArrangement = Arrangement.SpaceBetween
                ) {
                    Text(
                        "Available: ${"%.1f".format(totalGb - usedGb)} GB",
                        style = MaterialTheme.typography.labelMedium
                    )
                    Text(
                        "${(progress * 100).toInt()}% used",
                        style = MaterialTheme.typography.labelMedium
                    )
                }
            }
        }
    }

    @Composable
    private fun QuickAccessItem(
        option: StorageOption,
        onClick: () -> Unit,
        modifier: Modifier = Modifier
    ) {
        Card(
            onClick = onClick,
            modifier = modifier
                .width(120.dp)
                .height(100.dp),
            colors = CardDefaults.cardColors(
                containerColor = MaterialTheme.colorScheme.surfaceVariant.copy(alpha = 0.3f)
            )
        ) {
            Column(
                modifier = Modifier
                    .fillMaxSize()
                    .padding(12.dp),
                horizontalAlignment = Alignment.CenterHorizontally,
                verticalArrangement = Arrangement.Center
            ) {
                Icon(
                    imageVector = option.icon,
                    contentDescription = null,
                    tint = option.iconTint,
                    modifier = Modifier.size(32.dp)
                )
                Spacer(modifier = Modifier.height(8.dp))
                Text(
                    text = option.name,
                    style = MaterialTheme.typography.labelMedium,
                    textAlign = TextAlign.Center,
                    maxLines = 2,
                    overflow = TextOverflow.Ellipsis
                )
            }
        }
    }

    // --- PREVIEW for HomeScreen ---
    @Preview(showBackground = true)
    @Composable
    fun PreviewHomeScreen() {
        TabFileExplorerTheme {
            HomeScreen(onNavigateToStorage = {})
        }
    }

    // --- FileListScreen - Main UI Composables (FileItem, getFileIcon) ---
    @OptIn(ExperimentalMaterial3Api::class, ExperimentalFoundationApi::class)
    @Composable
    fun FileListScreen(
        files: List<FileModel>,
        currentPath: String,
        onFileClick: (String) -> Unit,
        onNavigateUp: () -> Unit,
        modifier: Modifier = Modifier,
        context: Context,
        // Search State
        isSearchActive: Boolean,
        searchQuery: String,
        onSearchQueryChange: (String) -> Unit,
        onSearchActiveChange: (Boolean) -> Unit,
        // View Mode State
        viewMode: ViewMode,
        onViewModeChange: (ViewMode) -> Unit,
        // --- SELECTION STATE PARAMETERS ---
        selectedFiles: Set<FileModel>,
        onSelectionChange: (FileModel) -> Unit,
        onClearSelection: () -> Unit,
        // --- SELECTION MENU PARAMETERS ---
        showSelectionMoreMenu: Boolean,
        onShowSelectionMoreMenu: () -> Unit,
        onDismissSelectionMoreMenu: () -> Unit,
        // --- Options Menu State ---
        showOptionsMenuForFile: FileModel?,
        onShowOptionsMenu: (FileModel) -> Unit,
        onDismissOptionsMenu: () -> Unit,
        onOpenFileClickAction: (FileModel) -> Unit,
        onRenameFileClickAction: (FileModel) -> Unit,
        onDeleteSelectedFiles: () -> Unit,
        onDeleteFileClickAction: (FileModel) -> Unit,
        onShareFiles: (FileModel?) -> Unit,
        onShowProperties: (file: FileModel?) -> Unit,
        sortMethod: SortMethod,
        sortOrder: SortOrder,
        onSortMethodChange: (SortMethod) -> Unit,
        onSortOrderChange: (SortOrder) -> Unit,
        showSortMenu: Boolean,
        onShowSortMenuChange: (Boolean) -> Unit,
        onToggleSplitScreen: () -> Unit,
        isSplitScreenActive: Boolean
    ) {
        val focusRequester = remember { FocusRequester() }
        val keyboardController = LocalSoftwareKeyboardController.current
        val isSelectionMode = selectedFiles.isNotEmpty()
        val snackbarHostState = remember { SnackbarHostState() }

        // --- Back Button Handler ---
        BackHandler(enabled = isSearchActive || isSelectionMode) {
            when {
                isSearchActive -> {
                    onSearchActiveChange(false)
                    onSearchQueryChange("")
                }

                isSelectionMode -> onClearSelection()
            }
        }

        Scaffold(
            topBar = {
                AnimatedContent(
                    targetState = isSelectionMode,
                    label = "TopBarAnimation",
                    transitionSpec = {
                        if (targetState) {
                            slideInVertically { height -> height } + fadeIn() togetherWith slideOutVertically { height -> -height } + fadeOut()
                        } else {
                            slideInVertically { height -> -height } + fadeIn() togetherWith slideOutVertically { height -> height } + fadeOut()
                        }
                    }
                ) { isInSelectionMode ->
                    if (isInSelectionMode) {
                        // --- UI FOR SELECTION MODE ---
                        TopAppBar(
                            title = { Text("${selectedFiles.size} selected") },
                            navigationIcon = {
                                Row {
                                    // Only show home button when not at root directory
                                    if (currentPath != Environment.getExternalStorageDirectory().absolutePath) {
                                        IconButton(
                                            onClick = {
                                                // Navigate to root directory
                                                onFileClick(Environment.getExternalStorageDirectory().absolutePath)
                                            }
                                        ) {
                                            Icon(
                                                imageVector = Icons.Default.Home,
                                                contentDescription = "Home",
                                                tint = MaterialTheme.colorScheme.onPrimaryContainer
                                            )
                                        }
                                    }

                                    // Back button
                                    IconButton(
                                        onClick = {
                                            if (isSearchActive) {
                                                onSearchActiveChange(false)
                                                onSearchQueryChange("")
                                            } else {
                                                onNavigateUp()
                                            }
                                        }
                                    ) {
                                        Icon(
                                            imageVector = Icons.AutoMirrored.Filled.ArrowBack,
                                            contentDescription = if (isSearchActive) "Close Search" else "Navigate Up",
                                            tint = MaterialTheme.colorScheme.onPrimaryContainer
                                        )
                                    }
                                }
                            },
                            actions = {
                                IconButton(onClick = { /* TODO: Copy Action */ }) {
                                    Icon(Icons.Filled.ContentCopy, contentDescription = "Copy")
                                }
                                IconButton(onClick = { /* TODO: Cut Action */ }) {
                                    Icon(Icons.Filled.ContentCut, contentDescription = "Cut")
                                }
                                IconButton(onClick = { onDeleteSelectedFiles() }) {
                                    Icon(Icons.Filled.Delete, contentDescription = "Delete")
                                }
                                // The "More" menu button
                                Box {
                                    IconButton(onClick = { onShowSelectionMoreMenu() }) {
                                        Icon(
                                            Icons.Filled.MoreVert,
                                            contentDescription = "More Options"
                                        )
                                    }
                                    // The DropdownMenu for the "More" button
                                    DropdownMenu(
                                        expanded = showSelectionMoreMenu,
                                        onDismissRequest = onDismissSelectionMoreMenu
                                    ) {
                                        // Group 1: Sharing and Actions
                                        DropdownMenuItem(
                                            text = { Text("Share") },
                                            onClick = {
                                                onShareFiles(showOptionsMenuForFile)
                                                onDismissSelectionMoreMenu()
                                            },
                                            leadingIcon = { Icon(Icons.Filled.Share, "Share") }
                                        )
                                        DropdownMenuItem(
                                            text = { Text("Compress") },
                                            onClick = {
                                                // TODO: Implement Compress logic for selected files
                                                onDismissSelectionMoreMenu()
                                            },
                                            leadingIcon = {
                                                Icon(
                                                    Icons.Filled.FolderZip,
                                                    "Compress"
                                                )
                                            }
                                        )

                                        // This is the separator for visual grouping
                                        HorizontalDivider(modifier = Modifier.padding(vertical = 4.dp))

                                        // Group 2: Information
                                        DropdownMenuItem(
                                            text = { Text("Copy path") },
                                            onClick = {
                                                // TODO: Implement Copy Path logic (e.g., copy all paths to clipboard)
                                                onDismissSelectionMoreMenu()
                                            },
                                            leadingIcon = { Icon(Icons.Filled.Link, "Copy path") }
                                        )
                                        DropdownMenuItem(
                                            text = { Text("Properties") },
                                            onClick = {
                                                onShowProperties(null)
                                                onDismissSelectionMoreMenu()
                                            },
                                            leadingIcon = { Icon(Icons.Filled.Info, "Properties") }
                                        )
                                    }
                                }
                            },
                            colors = TopAppBarDefaults.topAppBarColors(
                                containerColor = MaterialTheme.colorScheme.secondaryContainer,
                            )
                        )
                    } else {
                        // --- NORMAL/SEARCH MODE APP BAR ---
                        TopAppBar(
                            title = {
                                AnimatedContent(
                                    targetState = isSearchActive,
                                    label = "SearchTitleAnimation"
                                ) { searchIsActive ->
                                    if (searchIsActive) {
                                        TextField(
                                            value = searchQuery,
                                            onValueChange = onSearchQueryChange,
                                            placeholder = { Text("Search...") },
                                            singleLine = true,
                                            textStyle = LocalTextStyle.current.copy(color = MaterialTheme.colorScheme.onPrimaryContainer),
                                            modifier = Modifier
                                                .fillMaxWidth()
                                                .focusRequester(focusRequester),
                                            colors = TextFieldDefaults.colors(
                                                focusedContainerColor = Color.Transparent,
                                                unfocusedContainerColor = Color.Transparent,
                                                disabledContainerColor = Color.Transparent,
                                                focusedIndicatorColor = Color.Transparent,
                                                unfocusedIndicatorColor = Color.Transparent,
                                                cursorColor = MaterialTheme.colorScheme.onPrimaryContainer
                                            )
                                        )
                                    } else {
                                        Column(modifier = Modifier.fillMaxWidth()) {
                                            Text(
                                                text = File(currentPath).name.ifBlank { "Internal Storage" },
                                                fontSize = 18.sp,
                                                fontWeight = FontWeight.Medium,
                                                maxLines = 1,
                                                overflow = TextOverflow.Ellipsis
                                            )
                                            Text(
                                                text = "${files.size} item${if (files.size != 1) "s" else ""}",
                                                fontSize = 12.sp,
                                                color = MaterialTheme.colorScheme.onPrimaryContainer.copy(
                                                    alpha = 0.8f
                                                )
                                            )
                                        }
                                    }
                                }
                            },
                            navigationIcon = {
                                if (isSearchActive) {
                                    IconButton(onClick = {
                                        onSearchActiveChange(false)
                                        onSearchQueryChange("")
                                    }) {
                                        Icon(
                                            imageVector = Icons.AutoMirrored.Filled.ArrowBack,
                                            contentDescription = "Close Search"
                                        )
                                    }
                                } else {
                                    Row {
                                        // Home button - only show when not in selection mode
                                        if (!isSelectionMode) {
                                            IconButton(
                                                onClick = {
                                                    isAtRoot = true
                                                    onFileClick(Environment.getExternalStorageDirectory().absolutePath)
                                                }
                                            ) {
                                                Icon(
                                                    imageVector = Icons.Default.Home,
                                                    contentDescription = "Home"
                                                )
                                            }
                                        }
                                        
                                        // Back button
                                        IconButton(onClick = { onNavigateUp() }) {
                                            Icon(
                                                imageVector = Icons.AutoMirrored.Filled.ArrowBack,
                                                contentDescription = "Navigate Up"
                                            )
                                        }
                                    }
                                }
                            },
                            actions = {
                                AnimatedContent(
                                    targetState = isSearchActive,
                                    label = "SearchActionsAnimation"
                                ) { searchIsActive ->
                                    Row {
                                        if (searchIsActive) {
                                            if (searchQuery.isNotEmpty()) {
                                                IconButton(onClick = { onSearchQueryChange("") }) {
                                                    Icon(
                                                        Icons.Filled.Clear,
                                                        contentDescription = "Clear Search"
                                                    )
                                                }
                                            }
                                        } else {
                                            IconButton(onClick = { onSearchActiveChange(true) }) {
                                                Icon(
                                                    Icons.Filled.Search,
                                                    contentDescription = "Search Files"
                                                )
                                            }
                                            Box {
                                                IconButton(onClick = { onShowSortMenuChange(true) }) {
                                                    Icon(
                                                        Icons.AutoMirrored.Filled.Sort,
                                                        contentDescription = "Sort Files"
                                                    )
                                                }
                                                DropdownMenu(
                                                    expanded = showSortMenu,
                                                    onDismissRequest = { onShowSortMenuChange(false) }
                                                ) {
                                                    Text(
                                                        "Sort by",
                                                        modifier = Modifier.padding(
                                                            horizontal = 16.dp,
                                                            vertical = 8.dp
                                                        ),
                                                        style = MaterialTheme.typography.titleSmall
                                                    )
                                                    DropdownMenuItem(
                                                        text = { Text("Name") },
                                                        onClick = {
                                                            onSortMethodChange(SortMethod.NAME); onShowSortMenuChange(
                                                            false
                                                        )
                                                        },
                                                        trailingIcon = {
                                                            if (sortMethod == SortMethod.NAME) Icon(
                                                                Icons.Filled.Check,
                                                                contentDescription = "Selected"
                                                            )
                                                        }
                                                    )
                                                    DropdownMenuItem(
                                                        text = { Text("Date") },
                                                        onClick = {
                                                            onSortMethodChange(SortMethod.DATE); onShowSortMenuChange(
                                                            false
                                                        )
                                                        },
                                                        trailingIcon = {
                                                            if (sortMethod == SortMethod.DATE) Icon(
                                                                Icons.Filled.Check,
                                                                contentDescription = "Selected"
                                                            )
                                                        }
                                                    )
                                                    DropdownMenuItem(
                                                        text = { Text("Size") },
                                                        onClick = {
                                                            onSortMethodChange(SortMethod.SIZE); onShowSortMenuChange(
                                                            false
                                                        )
                                                        },
                                                        trailingIcon = {
                                                            if (sortMethod == SortMethod.SIZE) Icon(
                                                                Icons.Filled.Check,
                                                                contentDescription = "Selected"
                                                            )
                                                        }
                                                    )
                                                    DropdownMenuItem(
                                                        text = { Text("Type (Extension)") },
                                                        onClick = {
                                                            onSortMethodChange(SortMethod.TYPE); onShowSortMenuChange(
                                                            false
                                                        )
                                                        },
                                                        trailingIcon = {
                                                            if (sortMethod == SortMethod.TYPE) Icon(
                                                                Icons.Filled.Check,
                                                                contentDescription = "Selected"
                                                            )
                                                        }
                                                    )
                                                    HorizontalDivider(
                                                        modifier = Modifier.padding(
                                                            vertical = 4.dp
                                                        )
                                                    )
                                                    Text(
                                                        "Order",
                                                        modifier = Modifier.padding(
                                                            horizontal = 16.dp,
                                                            vertical = 8.dp
                                                        ),
                                                        style = MaterialTheme.typography.titleSmall
                                                    )
                                                    DropdownMenuItem(
                                                        text = { Text("Ascending") },
                                                        onClick = {
                                                            onSortOrderChange(SortOrder.ASCENDING); onShowSortMenuChange(
                                                            false
                                                        )
                                                        },
                                                        trailingIcon = {
                                                            if (sortOrder == SortOrder.ASCENDING) Icon(
                                                                Icons.Filled.Check,
                                                                contentDescription = "Selected"
                                                            )
                                                        }
                                                    )
                                                    DropdownMenuItem(
                                                        text = { Text("Descending") },
                                                        onClick = {
                                                            onSortOrderChange(SortOrder.DESCENDING); onShowSortMenuChange(
                                                            false
                                                        )
                                                        },
                                                        trailingIcon = {
                                                            if (sortOrder == SortOrder.DESCENDING) Icon(
                                                                Icons.Filled.Check,
                                                                contentDescription = "Selected"
                                                            )
                                                        }
                                                    )
                                                }
                                            }
                                            IconButton(onClick = { onViewModeChange(if (viewMode == ViewMode.LIST) ViewMode.GRID else ViewMode.LIST) }) {
                                                Icon(
                                                    imageVector = if (viewMode == ViewMode.LIST) Icons.Filled.GridView else Icons.AutoMirrored.Filled.ViewList,
                                                    contentDescription = "Toggle View"
                                                )
                                            }
                                            IconButton(onClick = { onToggleSplitScreen() }) {
                                                Icon(
                                                    imageVector = Icons.Filled.Splitscreen,
                                                    contentDescription = "Toggle Split Screen"
                                                )
                                            }
                                        }
                                    }
                                }
                            },
                            colors = TopAppBarDefaults.topAppBarColors(containerColor = MaterialTheme.colorScheme.primaryContainer)
                        )
                    }
                }
            },
            modifier = modifier,
            snackbarHost = { SnackbarHost(snackbarHostState) }
        ) { innerPadding ->
            // Add this LaunchedEffect right after the Scaffold's content starts
            LaunchedEffect(clipboardData) {
                clipboardData?.let { (sourcePath, isCut) ->
                    val sourceFile = File(sourcePath)
                    val actionText = if (isCut) "Cut" else "Copied"
                    val result = try {
                        snackbarHostState.showSnackbar(
                            message = "$actionText: ${sourceFile.name}",
                            actionLabel = "Paste",
                            duration = SnackbarDuration.Indefinite, // Changed from Short to Indefinite
                            withDismissAction = true // Adds a close button
                        )
                    } catch (e: Exception) {
                        Log.e("SnackbarError", "Error showing snackbar", e)
                        return@LaunchedEffect
                    }

                    when (result) {
                        SnackbarResult.ActionPerformed -> {
                            // Pass the snackbarHostState to pasteFromClipboard
                            pasteFromClipboard(snackbarHostState = snackbarHostState)
                        }

                        SnackbarResult.Dismissed -> {
                            // User swiped the snackbar away or tapped the close button
                        }
                    }
                }
            }
            // This effect manages the keyboard automatically
            LaunchedEffect(isSearchActive) {
                if (isSearchActive) {
                    focusRequester.requestFocus()
                } else {
                    keyboardController?.hide()
                }
            }

            // --- UPGRADED File List ---
            if (isSplitScreenActive) {
                // Split screen view
                Row(
                    modifier = Modifier
                        .fillMaxSize()
                        .padding(innerPadding)
                ) {
                    // Left panel (current directory)
                    Box(
                        modifier = Modifier
                            .weight(1f)
                            .fillMaxHeight()
                    ) {
                        if (viewMode == ViewMode.LIST) {
                            LazyColumn(
                                modifier = Modifier.fillMaxSize()
                            ) {
                                items(files, key = { it.path }) { fileModel ->
                                    FileItem(
                                        fileModel = fileModel,
                                        isSelected = selectedFiles.contains(fileModel),
                                        onItemClick = { fm ->
                                            if (isSelectionMode) onSelectionChange(fm) else if (fm.isDirectory) onFileClick(
                                                fm.path
                                            ) else onOpenFileClickAction(fm)
                                        },
                                        onItemLongClick = { fm -> onSelectionChange(fm) },
                                        onOptionsMenuClick = { fm -> onShowOptionsMenu(fm) }
                                    )
                                }
                            }
                        } else {
                            LazyVerticalGrid(
                                columns = GridCells.Adaptive(minSize = 120.dp),
                                modifier = Modifier.fillMaxSize(),
                                contentPadding = PaddingValues(4.dp)
                            ) {
                                items(files, key = { it.path }) { fileModel ->
                                    GridItem(
                                        fileModel = fileModel,
                                        isSelected = selectedFiles.contains(fileModel),
                                        onItemClick = { fm ->
                                            if (isSelectionMode) onSelectionChange(fm) else if (fm.isDirectory) onFileClick(
                                                fm.path
                                            ) else onOpenFileClickAction(fm)
                                        },
                                        onItemLongClick = { fm -> onSelectionChange(fm) }
                                    )
                                }
                            }
                        }
                    }

                    // Divider between panels
                    HorizontalDivider(
                        modifier = Modifier
                            .fillMaxHeight()
                            .width(1.dp),
                        thickness = DividerDefaults.Thickness,
                        color = MaterialTheme.colorScheme.outlineVariant
                    )

                    // Right panel (default to parent directory or a default location)
                    val rightPanelPath = remember { File(currentPath).parent ?: "/" }
                    val rightPanelFiles = remember(rightPanelPath, sortMethod, sortOrder) {
                        FileUtils.getFiles(rightPanelPath)?.let { files ->
                            val sorted = when (sortMethod) {
                                SortMethod.NAME -> files.sortedBy { it.name.lowercase(Locale.getDefault()) }
                                SortMethod.DATE -> files.sortedBy { it.lastModified }
                                SortMethod.SIZE -> files.sortedBy { it.size }
                                SortMethod.TYPE -> files.sortedBy {
                                    it.name.substringAfterLast(
                                        '.',
                                        ""
                                    ).lowercase(Locale.getDefault())
                                }
                            }
                            if (sortOrder == SortOrder.DESCENDING) sorted.reversed() else sorted
                        } ?: emptyList()
                    }

                    Box(
                        modifier = Modifier
                            .weight(1f)
                            .fillMaxHeight()
                    ) {
                        if (viewMode == ViewMode.LIST) {
                            LazyColumn(
                                modifier = Modifier.fillMaxSize()
                            ) {
                                items(rightPanelFiles, key = { it.path }) { fileModel ->
                                    FileItem(
                                        fileModel = fileModel,
                                        isSelected = false,
                                        onItemClick = { fm ->
                                            if (fm.isDirectory) {
                                                // In a real implementation, you'd update the right panel's path
                                                // For now, we'll just open the file
                                                onOpenFileClickAction(fm)
                                            } else {
                                                onOpenFileClickAction(fm)
                                            }
                                        },
                                        onItemLongClick = { /* No action for right panel in this implementation */ },
                                        onOptionsMenuClick = { /* No options menu for right panel in this implementation */ }
                                    )
                                }
                            }
                        } else {
                            LazyVerticalGrid(
                                columns = GridCells.Adaptive(minSize = 120.dp),
                                modifier = Modifier.fillMaxSize(),
                                contentPadding = PaddingValues(4.dp)
                            ) {
                                items(rightPanelFiles, key = { it.path }) { fileModel ->
                                    GridItem(
                                        fileModel = fileModel,
                                        isSelected = false,
                                        onItemClick = { fm ->
                                            if (fm.isDirectory) {
                                                // In a real implementation, you'd update the right panel's path
                                                // For now, we'll just open the file
                                                onOpenFileClickAction(fm)
                                            } else {
                                                onOpenFileClickAction(fm)
                                            }
                                        },
                                        onItemLongClick = { /* No action for right panel in this implementation */ }
                                    )
                                }
                            }
                        }
                    }
                }
            } else {
                // Single panel view
                if (viewMode == ViewMode.LIST) {
                    LazyColumn(
                        modifier = Modifier
                            .fillMaxSize()
                            .padding(innerPadding)
                    ) {
                        items(files, key = { it.path }) { fileModel ->
                            FileItem(
                                fileModel = fileModel,
                                isSelected = selectedFiles.contains(fileModel),
                                onItemClick = { fm ->
                                    if (isSelectionMode) onSelectionChange(fm) else if (fm.isDirectory) onFileClick(
                                        fm.path
                                    ) else onOpenFileClickAction(fm)
                                },
                                onItemLongClick = { fm -> onSelectionChange(fm) },
                                onOptionsMenuClick = { fm -> onShowOptionsMenu(fm) }
                            )
                        }
                    }
                } else {
                    LazyVerticalGrid(
                        columns = GridCells.Adaptive(minSize = 120.dp),
                        modifier = Modifier
                            .fillMaxSize()
                            .padding(innerPadding),
                        contentPadding = PaddingValues(4.dp)
                    ) {
                        items(files, key = { it.path }) { fileModel ->
                            GridItem(
                                fileModel = fileModel,
                                isSelected = selectedFiles.contains(fileModel),
                                onItemClick = { fm ->
                                    if (isSelectionMode) onSelectionChange(fm) else if (fm.isDirectory) onFileClick(
                                        fm.path
                                    ) else onOpenFileClickAction(fm)
                                },
                                onItemLongClick = { fm -> onSelectionChange(fm) }
                            )
                        }
                    }
                }
            }

            if (!isSelectionMode) {
                DropdownMenu(
                    expanded = (showOptionsMenuForFile != null),
                    onDismissRequest = onDismissOptionsMenu
                ) {
                    val file = showOptionsMenuForFile ?: return@DropdownMenu
                    DropdownMenuItem(
                        text = { Text("Copy") },
                        onClick = {
                            copyToClipboard(file)
                            onDismissOptionsMenu()
                        },
                        leadingIcon = {
                            Icon(
                                imageVector = Icons.Default.ContentCopy,
                                contentDescription = "Copy"
                            )
                        }
                    )

                    DropdownMenuItem(
                        text = { Text("Cut") },
                        onClick = {
                            cutToClipboard(file)
                            onDismissOptionsMenu()
                        },
                        leadingIcon = {
                            Icon(
                                imageVector = Icons.Default.ContentCut,
                                contentDescription = "Cut"
                            )
                        }
                    )

                    // Add paste option if clipboard has data
                    if (clipboardData != null) {
                        val (sourcePath, isCut) = clipboardData!!
                        val sourceFile = File(sourcePath)
                        val actionText = if (isCut) "Cut" else "Copied"
                        val icon =
                            if (isCut) Icons.Default.ContentCut else Icons.Default.ContentCopy

                        // Show a chip with the action and filename
                        Surface(
                            shape = MaterialTheme.shapes.small,
                            color = MaterialTheme.colorScheme.secondaryContainer,
                            modifier = Modifier
                                .padding(horizontal = 4.dp)
                                .height(32.dp)
                        ) {
                            Row(
                                verticalAlignment = Alignment.CenterVertically,
                                modifier = Modifier.padding(horizontal = 8.dp)
                            ) {
                                Icon(
                                    imageVector = icon,
                                    contentDescription = actionText,
                                    tint = MaterialTheme.colorScheme.onSecondaryContainer,
                                    modifier = Modifier.size(16.dp)
                                )
                                Spacer(modifier = Modifier.width(4.dp))
                                Text(
                                    text = "$actionText: ${sourceFile.name}",
                                    style = MaterialTheme.typography.labelSmall,
                                    color = MaterialTheme.colorScheme.onSecondaryContainer,
                                    maxLines = 1,
                                    overflow = TextOverflow.Ellipsis
                                )
                            }
                        }

                        // Paste button
                        IconButton(
                            onClick = {
                                // Pass the snackbarHostState to pasteFromClipboard
                                pasteFromClipboard(File(currentPathState), snackbarHostState)
                            }
                        ) {
                            Icon(
                                imageVector = Icons.Default.ContentPaste,
                                contentDescription = "Paste",
                                tint = MaterialTheme.colorScheme.primary
                            )
                        }
                        DropdownMenuItem(
                            text = { Text("Paste") },
                            onClick = {
                                pasteFromClipboard(File(currentPathState), snackbarHostState)
                                onDismissOptionsMenu()
                            },
                            leadingIcon = {
                                Icon(
                                    imageVector = Icons.Default.ContentPaste,
                                    contentDescription = "Paste"
                                )
                            }
                        )
                        HorizontalDivider(
                            Modifier,
                            DividerDefaults.Thickness,
                            DividerDefaults.color
                        )
                    }
                    DropdownMenuItem(
                        text = { Text("Open") },
                        onClick = { onOpenFileClickAction(file); onDismissOptionsMenu() },
                        leadingIcon = { Icon(Icons.AutoMirrored.Filled.Launch, "Open") })
                    DropdownMenuItem(
                        text = { Text("Rename") },
                        onClick = {
                            showOptionsMenuForFile?.let { file ->
                                showRenameDialog(file)
                                onDismissOptionsMenu()
                            } ?: run {
                                onDismissOptionsMenu()
                            }
                        },
                        leadingIcon = {
                            Icon(
                                imageVector = Icons.Filled.DriveFileRenameOutline,
                                contentDescription = "Rename"
                            )
                        }
                    )
                    DropdownMenuItem(
                        text = { Text("Share") },
                        onClick = {
                            onShareFiles(file)
                            onDismissOptionsMenu()
                        },
                        leadingIcon = { Icon(Icons.Filled.Share, "Share") }
                    )
                    HorizontalDivider(modifier = Modifier.padding(vertical = 4.dp))
                    DropdownMenuItem(
                        text = { Text("Add to Home screen") },
                        onClick = { onDismissOptionsMenu() },
                        leadingIcon = { Icon(Icons.Filled.AddHome, "Add to Home screen") })
                    DropdownMenuItem(
                        text = { Text("Create shortcut") },
                        onClick = { onDismissOptionsMenu() },
                        leadingIcon = {
                            Icon(
                                Icons.AutoMirrored.Filled.Shortcut,
                                "Create shortcut"
                            )
                        })
                    HorizontalDivider(modifier = Modifier.padding(vertical = 4.dp))
                    DropdownMenuItem(
                        text = { Text("Copy path") },
                        onClick = {
                            copyPathToClipboard(
                                showOptionsMenuForFile?.path ?: return@DropdownMenuItem
                            )
                            onDismissOptionsMenu()
                        },
                        leadingIcon = { Icon(Icons.Filled.Link, "Copy path") })
                    DropdownMenuItem(
                        text = { Text("Properties") },
                        onClick = {
                            onShowProperties(file)
                            onDismissOptionsMenu()
                        },
                        leadingIcon = { Icon(Icons.Filled.Info, "Properties") }
                    )
                }
            }
        }
    }

    @Composable
    private fun RenameDialog(
        currentFile: FileModel,
        newFileName: String,
        onNewFileNameChange: (String) -> Unit,
        onDismiss: () -> Unit,
        onConfirm: () -> Unit,
        isNameValid: Boolean
    ) {
        val hasExtension = currentFile.name.contains('.')
        val extension = if (hasExtension) ".${currentFile.name.substringAfterLast('.')}" else ""

        AlertDialog(
            onDismissRequest = onDismiss,
            title = { Text("Rename ${currentFile.name}") },
            text = {
                Column {
                    Text("Enter new name:")
                    OutlinedTextField(
                        value = newFileName,
                        onValueChange = onNewFileNameChange,
                        modifier = Modifier.fillMaxWidth(),
                        singleLine = true,
                        suffix = {
                            if (hasExtension) {
                                Text(
                                    text = extension,
                                    color = MaterialTheme.colorScheme.onSurfaceVariant
                                )
                            }
                        }
                    )
                    if (hasExtension) {
                        Text(
                            text = "Extension will be preserved: $extension",
                            style = MaterialTheme.typography.bodySmall,
                            color = MaterialTheme.colorScheme.onSurfaceVariant
                        )
                    }
                }
            },
            confirmButton = {
                Button(
                    onClick = onConfirm,
                    enabled = isNameValid
                ) {
                    Text("Rename")
                }
            },
            dismissButton = {
                TextButton(onClick = onDismiss) {
                    Text("Cancel")
                }
            }
        )
    }

    @OptIn(ExperimentalMaterial3Api::class)
    @Composable
    fun CreateFolderDialog(
        folderName: String,
        onFolderNameChange: (String) -> Unit,
        onDismissRequest: () -> Unit,
        onCreateClick: () -> Unit,
        onCancelClick: () -> Unit
    ) {
        AlertDialog(
            onDismissRequest = onDismissRequest,
            title = { Text("Create New Folder") },
            text = {
                OutlinedTextField(
                    value = folderName,
                    onValueChange = onFolderNameChange,
                    label = { Text("Folder Name") },
                    singleLine = true,
                    modifier = Modifier.fillMaxWidth()
                )
            },
            confirmButton = {
                Button(
                    onClick = {
                        if (folderName.isNotBlank()) {
                            onCreateClick()
                        }
                        // Optionally, you could show a Toast if folderName is blank
                    },
                    enabled = folderName.isNotBlank() // Enable button only if name is not blank
                ) {
                    Text("Create")
                }
            },
            dismissButton = {
                TextButton(onClick = onCancelClick) {
                    Text("Cancel")
                }
            }
        )
    }

    @Composable
    fun ConfirmDeleteDialog(
        file: FileModel,
        onConfirm: () -> Unit,
        onDismiss: () -> Unit
    ) {
        AlertDialog(
            onDismissRequest = onDismiss,
            title = { Text("Confirm Delete") },
            text = { Text("Are you sure you want to delete '${file.name}'?") },
            confirmButton = {
                Button(
                    onClick = onConfirm,
                    colors = ButtonDefaults.buttonColors(containerColor = MaterialTheme.colorScheme.error)
                ) {
                    Text("Delete")
                }
            },
            dismissButton = {
                TextButton(onClick = onDismiss) {
                    Text("Cancel")
                }
            }
        )
    }

    @OptIn(ExperimentalFoundationApi::class)
    @Composable
    fun FileItem(
        fileModel: FileModel,
        isSelected: Boolean,
        onItemClick: (FileModel) -> Unit,
        onItemLongClick: (FileModel) -> Unit,
        onOptionsMenuClick: (FileModel) -> Unit
    ) {
        Row(
            modifier = Modifier
                .fillMaxWidth()
                .background(if (isSelected) MaterialTheme.colorScheme.primary.copy(alpha = 0.15f) else Color.Transparent)
                .combinedClickable(
                    onClick = { onItemClick(fileModel) },
                    onLongClick = { onItemLongClick(fileModel) }
                )
                .padding(start = 16.dp),
            verticalAlignment = Alignment.CenterVertically
        ) {
            Icon(
                imageVector = getFileIcon(fileModel),
                contentDescription = null,
                modifier = Modifier.size(40.dp),
                tint = if (isSelected) MaterialTheme.colorScheme.primary else MaterialTheme.colorScheme.onSurfaceVariant
            )
            Spacer(modifier = Modifier.width(16.dp))
            Column(
                modifier = Modifier
                    .weight(1f)
                    .padding(vertical = 8.dp)
            ) {
                Text(
                    text = fileModel.name,
                    style = MaterialTheme.typography.bodyLarge,
                    fontWeight = FontWeight.Medium,
                    maxLines = 1,
                    overflow = TextOverflow.Ellipsis,
                    color = MaterialTheme.colorScheme.onSurface
                )
                Spacer(modifier = Modifier.height(3.dp))
                Row(verticalAlignment = Alignment.CenterVertically) {
                    val secondaryTextStyle = MaterialTheme.typography.bodySmall.copy(
                        color = MaterialTheme.colorScheme.onSurfaceVariant
                    )
                    if (fileModel.isDirectory) {
                        Text(
                            text = fileModel.childrenCount?.let { count ->
                                if (count > 0) "$count item${if (count != 1) "s" else ""}" else "Empty folder"
                            } ?: "Folder",
                            style = secondaryTextStyle,
                            maxLines = 1,
                            overflow = TextOverflow.Ellipsis
                        )
                        Text("  •  ", style = secondaryTextStyle)
                    } else {
                        Text(
                            text = fileModel.size.toReadableFileSizeString(),
                            style = secondaryTextStyle,
                            maxLines = 1,
                            overflow = TextOverflow.Ellipsis
                        )
                        Text("  •  ", style = secondaryTextStyle)
                    }
                    Text(
                        text = fileModel.lastModified.toFormattedDateString("dd MMM yyyy"),
                        style = secondaryTextStyle,
                        maxLines = 1,
                        overflow = TextOverflow.Ellipsis
                    )
                }
            }
            // This is the three-dots menu, only for list item.
            IconButton(onClick = { onOptionsMenuClick(fileModel) }) {
                Icon(
                    imageVector = Icons.Filled.MoreVert,
                    contentDescription = "More options for ${fileModel.name}",
                    tint = MaterialTheme.colorScheme.onSurfaceVariant // Or choose another appropriate color
                )
            }
        }
    }

    @OptIn(ExperimentalFoundationApi::class)
    @Composable
    fun GridItem(
        fileModel: FileModel,
        isSelected: Boolean,
        onItemClick: (FileModel) -> Unit,
        onItemLongClick: (FileModel) -> Unit,
        modifier: Modifier = Modifier
    ) {
        Card(
            modifier = modifier
                .padding(4.dp)
                .fillMaxWidth()
                .combinedClickable(
                    onClick = { onItemClick(fileModel) },
                    onLongClick = { onItemLongClick(fileModel) } // <-- A long press now starts selection mode
                ),
            elevation = CardDefaults.cardElevation(defaultElevation = 1.dp),
            border = if (isSelected) BorderStroke(
                2.dp,
                MaterialTheme.colorScheme.primary
            ) else null // <-- Visual feedback for selection
        ) {
            Column(
                modifier = Modifier
                    .fillMaxSize()
                    .height(140.dp)
                    .padding(8.dp),
                horizontalAlignment = Alignment.CenterHorizontally,
                verticalArrangement = Arrangement.Center
            ) {
                Icon(
                    imageVector = getFileIcon(fileModel),
                    contentDescription = null,
                    modifier = Modifier.size(48.dp),
                    tint = if (fileModel.isDirectory) MaterialTheme.colorScheme.primary else MaterialTheme.colorScheme.onSurfaceVariant
                )
                Spacer(modifier = Modifier.height(12.dp))
                Text(
                    text = fileModel.name,
                    style = MaterialTheme.typography.bodyMedium,
                    maxLines = 2,
                    overflow = TextOverflow.Ellipsis,
                    textAlign = TextAlign.Center
                )
            }
        }
    }

    @Composable
    fun getFileIcon(fileModel: FileModel): ImageVector {
        // This function remains largely the same, ensure all icons used are Material Design icons
        // and available in your dependencies.
        return when {
            fileModel.isDirectory -> Icons.Filled.Folder
            else -> {
                val extension = fileModel.name.substringAfterLast('.', "").lowercase()
                when (extension) {
                    "jpg", "jpeg", "png", "gif", "bmp", "webp" -> Icons.Filled.Image
                    "mp3", "wav", "aac", "ogg", "m4a", "flac" -> Icons.Filled.MusicNote
                    "mp4", "mkv", "avi", "mov", "webm", "3gp" -> Icons.Filled.VideoFile // Or OndemandVideo
                    "pdf" -> Icons.Filled.PictureAsPdf
                    "doc", "docx" -> Icons.Filled.Description // Or Article
                    "xls", "xlsx" -> Icons.Filled.Analytics // Or TableChart
                    "ppt", "pptx" -> Icons.Filled.Slideshow
                    "txt", "log", "md" -> Icons.AutoMirrored.Filled.Notes // Or TextSnippet
                    "zip", "rar", "7z", "tar", "gz" -> Icons.Filled.Archive
                    "apk" -> Icons.Filled.Android // Or Adb
                    "html", "htm", "xml", "json" -> Icons.Filled.Code
                    "java", "kt", "js", "py", "c", "cpp", "cs", "swift" -> Icons.Filled.DataObject // Or Terminal
                    else -> Icons.AutoMirrored.Filled.InsertDriveFile
                }
            }
        }
    }


    @Composable
    fun PropertiesDialog(
        selectedFiles: Set<FileModel>,
        fileToShow: FileModel? = null,
        onDismissRequest: () -> Unit
    ) {
        // Determine what to show: the single file if provided, otherwise the selection.
        val finalFile = fileToShow
        val finalSelection = if (finalFile != null) setOf(finalFile) else selectedFiles

        if (finalSelection.isEmpty()) return

        val singleFile = if (finalSelection.size == 1) finalSelection.first() else null

        AlertDialog(
            onDismissRequest = onDismissRequest,
            title = {
                Text(
                    if (singleFile != null) "Properties"
                    else "Properties for ${finalSelection.size} items"
                )
            },
            text = {
                if (singleFile != null) {
                    // --- UI for a SINGLE file ---
                    PropertiesContent(
                        items = listOf(
                            "Name" to singleFile.name,
                            "Path" to singleFile.path,
                            "Size" to singleFile.size.toReadableFileSizeString(),
                            "Last Modified" to singleFile.lastModified.toFormattedDateString()
                        )
                    )
                } else {
                    // --- UI for MULTIPLE files ---
                    val totalSize = finalSelection.sumOf { it.size }
                    val folderCount = finalSelection.count { it.isDirectory }
                    val fileCount = finalSelection.size - folderCount
                    PropertiesContent(
                        items = listOf(
                            "Total items" to finalSelection.size.toString(),
                            "Files" to fileCount.toString(),
                            "Folders" to folderCount.toString(),
                            "Total size" to totalSize.toReadableFileSizeString()
                        )
                    )
                }
            },
            confirmButton = {
                TextButton(onClick = onDismissRequest) {
                    Text("OK")
                }
            }
        )
    }

    // A helper composable to keep the layout consistent
    @Composable
    private fun PropertiesContent(items: List<Pair<String, String>>) {
        LazyColumn {
            items(items) { (label, value) ->
                Row(modifier = Modifier.padding(vertical = 4.dp)) {
                    Text(
                        text = "$label:",
                        style = MaterialTheme.typography.bodyMedium,
                        fontWeight = FontWeight.Bold,
                        modifier = Modifier.width(120.dp) // Aligns the values
                    )
                    Text(
                        text = value,
                        style = MaterialTheme.typography.bodyMedium
                    )
                }
            }
        }
    }

