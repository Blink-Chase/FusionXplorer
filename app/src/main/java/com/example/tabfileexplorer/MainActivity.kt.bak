    @Composable
    fun HomeScreen(
        onNavigateToSettings: () -> Unit,
        onNavigateToDirectory: (String) -> Unit,
        modifier: Modifier = Modifier
    ) {
        val context = LocalContext.current
        val storageStats = remember { mutableStateOf<StorageStats?>(null) }
        val rootPath = Environment.getExternalStorageDirectory().absolutePath
        
        // Storage options (internal storage, downloads, etc.)
        val storageOptions = listOf(
            StorageOption(
                name = "Internal Storage",
                path = rootPath,
                icon = Icons.Filled.Storage,
                iconTint = MaterialTheme.colorScheme.primary
            ),
            StorageOption(
                name = "Downloads",
                path = "${Environment.getExternalStorageDirectory()}/Download",
                icon = Icons.Filled.Download,
                iconTint = MaterialTheme.colorScheme.primary
            )
        )
        
        // Get storage stats asynchronously
        LaunchedEffect(Unit) {
            withContext(Dispatchers.IO) {
                try {
                    val stats = context.getStorageStats()
                    withContext(Dispatchers.Main) {
                        storageStats.value = stats
                    }
                } catch (e: Exception) {
                    Log.e("HomeScreen", "Error getting storage stats", e)
                }
            }
        }
