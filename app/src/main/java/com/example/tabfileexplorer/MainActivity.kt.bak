                        color = MaterialTheme.colorScheme.onBackground, // Or onSurfaceVariant if you want it slightly dimmer
                        modifier = Modifier.padding(top = 8.dp)
                    )
                    Spacer(modifier = Modifier.height(24.dp))
                    Button(onClick = onGrantSettingsClick) {
                        Text("Grant in Settings")
                    }
                }
            }
        }
    }

    @Composable
    fun LoadingIndicatorOverlay() { // Content description not typically needed for a purely visual busy indicator
        Box(
            modifier = Modifier
                .fillMaxSize()
                .clickable(enabled = false, onClick = {}) // Consume clicks
                .padding(16.dp),
            contentAlignment = Alignment.Center
        ) {
            CircularProgressIndicator(modifier = Modifier.size(48.dp))
        }
    }

    @Composable
    fun EmptyFolderView(currentPath: String, onCreateFolderClick: () -> Unit) { // Added callback
        Box(modifier = Modifier.fillMaxSize(), contentAlignment = Alignment.Center) {
            Column(
                horizontalAlignment = Alignment.CenterHorizontally,
                modifier = Modifier.padding(16.dp)
            ) {
                Icon(
                    imageVector = Icons.Filled.Inbox, // Or Icons.Filled.FolderOpen
                    contentDescription = "Empty Folder Icon", // Accessibility
                    modifier = Modifier.size(48.dp),
                    tint = MaterialTheme.colorScheme.onSurfaceVariant.copy(alpha = 0.7f)
                )
                Spacer(modifier = Modifier.height(16.dp))
                val isReadable = FileUtils.isPathReadable(currentPath)
                Text(
                    if (!isReadable) "Cannot read this folder."
                    else "This folder is empty.",
                    style = MaterialTheme.typography.titleSmall,
                    color = if (!isReadable) MaterialTheme.colorScheme.error
                    else MaterialTheme.colorScheme.onSurfaceVariant
                )
                if (isReadable) { // Only show "Create New Folder" if the current path is readable
                    Spacer(modifier = Modifier.height(16.dp))
                    TextButton(onClick = onCreateFolderClick) { // Using TextButton for less emphasis
                        Icon(
                            Icons.Filled.CreateNewFolder,
                            contentDescription = "Create New Folder Icon", // Accessibility
                            modifier = Modifier.size(ButtonDefaults.IconSize)
                        )
                        Spacer(Modifier.size(ButtonDefaults.IconSpacing))
                        Text("Create New Folder")
                    }
                }
            }
        }
    }

    @Composable
    fun PreparingStateView() {
        Box(modifier = Modifier.fillMaxSize(), contentAlignment = Alignment.Center) {
